.DS_Store
__pycache__/
*.pyc
venv/

# mTLS material and runtime secrets issued by the hub — never commit these
certs/
.env
.env.lock
*.key
*.pem
*.crt
*.p12
*.pfx
keys.json
hub_secret.json
secrets.json

# Runtime logs (control_plane falls back to src/logs/ when /var/log/lm is not writable)
logs/
*.log
